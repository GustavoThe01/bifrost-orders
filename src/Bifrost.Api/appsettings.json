{
  "ConnectionStrings": {
    "Bifrost": "Data Source=bifrost.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Payments": {
    "BaseUrl": "http://localhost:5080/simulador/pagamentos/",
    "MaxRetryAttempts": 3,
    "RetryBaseDelay": "00:00:00.200",
    "AttemptTimeout": "00:00:02",
    "TotalTimeout": "00:00:10",
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 5,
    "CircuitSamplingDuration": "00:00:30",
    "CircuitBreakDuration": "00:00:15"
  },
  "PaymentSimulator": {
    "FailureRate": 0,
    "DeclineAbove": 10000
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "Jwt": {
    "Issuer": "bifrost-orders",
    "Audience": "bifrost-orders-api",
    "LifetimeMinutes": 60,
    "SigningKey": ""
  },
  "AllowedHosts": "*"
}
