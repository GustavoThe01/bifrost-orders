{
  "ConnectionStrings": {
    "Bifrost": "Data Source=bifrost.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "Jwt": {
    "Issuer": "bifrost-orders",
    "Audience": "bifrost-orders-api",
    "LifetimeMinutes": 60,
    "SigningKey": ""
  },
  "AllowedHosts": "*"
}
